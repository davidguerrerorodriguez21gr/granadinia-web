---
/** Plantilla de las páginas legales: cabecera, texto con índice y pie. */
import Base from './Base.astro';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';

interface Props {
  titulo: string;
  descripcion: string;
  actualizado: string;
}
const { titulo, descripcion, actualizado } = Astro.props;
---

<Base titulo={`${titulo} | GranadinIA`} descripcion={descripcion}>
  <Cabecera prefijo="/" />
  <main id="contenido" tabindex="-1" class="seccion legal">
    <article class="contenedor legal__texto">
      <p class="antetitulo">Información legal</p>
      <h1>{titulo}</h1>
      <p class="legal__fecha">Última actualización: {actualizado}</p>
      <slot />
    </article>
  </main>
  <Pie />
</Base>

<style>
  .legal {
    padding-top: var(--e-7);
  }
  .legal__texto {
    max-width: 48rem;
  }
  .legal__texto h1 {
    font-size: clamp(2.1rem, 1.6rem + 2.4vw, 3.2rem);
  }
  .legal__fecha {
    color: var(--texto-suave);
    font-size: var(--texto-pequeno);
    margin-bottom: var(--e-6);
  }
  .legal__texto :global(h2) {
    margin-top: var(--e-7);
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.8rem);
  }
  .legal__texto :global(h3) {
    margin-top: var(--e-5);
    font-size: 1.2rem;
  }
  .legal__texto :global(ul) {
    padding-left: 1.25rem;
  }
  .legal__texto :global(li) {
    margin-bottom: var(--e-2);
  }
  .legal__texto :global(.aviso-borrador) {
    padding: var(--e-4) var(--e-5);
    border-radius: var(--radio);
    border-left: 6px solid #c99a1a;
    background: var(--pendiente-fondo);
    color: var(--pendiente-texto);
    font-weight: var(--peso-medio);
  }
  .legal__texto :global(.tabla) {
    width: 100%;
    overflow-x: auto;
    margin-bottom: var(--e-5);
  }
  .legal__texto :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--texto-pequeno);
  }
  .legal__texto :global(th),
  .legal__texto :global(td) {
    padding: var(--e-3);
    border-bottom: 1px solid var(--borde);
    text-align: left;
    vertical-align: top;
  }
  .legal__texto :global(th) {
    background: var(--fondo-alterno);
  }
  .legal__texto :global(dl) {
    display: grid;
    gap: var(--e-2);
  }
  .legal__texto :global(dl > div) {
    display: grid;
    gap: 0 var(--e-4);
  }
  @media (min-width: 40rem) {
    .legal__texto :global(dl > div) {
      grid-template-columns: 13rem 1fr;
    }
  }
  .legal__texto :global(dt) {
    font-weight: var(--peso-fuerte);
  }
  .legal__texto :global(dd) {
    margin: 0;
  }
</style>
