---
import '../styles/tokens.css';
import '../styles/base.css';
import { sitio } from '../config/sitio';
import { comunes } from '../content/textos';

interface Props {
  titulo: string;
  descripcion: string;
  ruta?: string;
  indexable?: boolean;
}
const { titulo, descripcion, indexable = true } = Astro.props;
const canonica = new URL(Astro.url.pathname, sitio.DOMINIO_PRINCIPAL).href;
const ogImagen = new URL('/og-image.png', sitio.DOMINIO_PRINCIPAL).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {!indexable && <meta name="robots" content="noindex" />}

    <!-- Tema y preferencia de movimiento antes de pintar (evita parpadeo) -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('granadinia-tema');
          if (t === 'claro' || t === 'oscuro') d.dataset.tema = t;
          if (localStorage.getItem('granadinia-movimiento') === 'reducido') d.dataset.movimiento = 'reducido';
        } catch (e) {}
        d.dataset.temaActual = d.dataset.tema || (matchMedia('(prefers-color-scheme: dark)').matches ? 'oscuro' : 'claro');
        var reducido = d.dataset.movimiento === 'reducido' || matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reducido) d.classList.add('anima');
      })();
    </script>

    <link rel="preload" href="/fonts/nunito-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#FDF5E5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1F120B" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={sitio.NOMBRE_MARCA} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={ogImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">{comunes.saltar}</a>
    <slot />
  </body>
</html>
