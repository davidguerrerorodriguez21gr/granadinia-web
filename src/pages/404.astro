---
import Base from '../layouts/Base.astro';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import Icono from '../components/Icono.astro';
import trazos from '../assets/marca/alhambra-paths.json';
import { whatsappConTexto } from '../config/sitio';
import { noEncontrada as t, comunes } from '../content/textos';
---

<Base titulo="Página no encontrada | GranadinIA" descripcion={t.texto} indexable={false}>
  <Cabecera prefijo="/" />
  <main id="contenido" tabindex="-1" class="seccion">
    <div class="contenedor error404">
      <svg class="error404__dibujo" viewBox={trazos.viewBox} aria-hidden="true" focusable="false">
        <path d={trazos.oscuro} class="o"></path>
        <path d={trazos.cobre} class="c"></path>
      </svg>
      <p class="antetitulo">Error 404</p>
      <h1>{t.titulo}</h1>
      <p class="entradilla">{t.texto}</p>
      <div class="error404__botones">
        <a class="boton boton--grande" href="/">{t.inicio}</a>
        <a class="boton boton--whatsapp boton--grande" href={whatsappConTexto()} rel="noopener">
          <Icono nombre="whatsapp" />
          {comunes.botonWhatsApp}
          <span class="sr-only">{comunes.seAbreWhatsApp}</span>
        </a>
      </div>
    </div>
  </main>
  <Pie />
</Base>

<style>
  .error404 {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .error404 .antetitulo::before {
    display: none;
  }
  .error404 h1 {
    max-width: 18ch;
  }
  .error404__dibujo {
    width: min(18rem, 70%);
    margin-bottom: var(--e-5);
    rotate: -4deg;
  }
  .o {
    fill: var(--titulo);
  }
  .c {
    fill: var(--decoracion);
  }
  .error404__botones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--e-3);
    margin-top: var(--e-4);
  }
</style>
