---
/**
 * Página interna de muestra del sistema de diseño (no se enlaza ni se indexa).
 * Se borrará antes de publicar.
 */
import Base from '../layouts/Base.astro';
import Cabecera from '../components/Cabecera.astro';
import Icono from '../components/Icono.astro';

const colores = [
  ['--crema', '#FDF5E5', 'Fondo principal', '—'],
  ['--marron', '#52301D', 'Texto y titulares', '10,8:1'],
  ['--marron-noche', '#2E1A10', 'Superficies oscuras', '15,2:1'],
  ['--cobre', '#9E683E', '“IA” y texto grande', '4,3:1 (grande)'],
  ['--cobre-oscuro', '#7A4A22', 'Enlaces y botones', '6,8:1'],
  ['--cobre-claro', '#B88255', 'Solo decoración', '3,0:1'],
  ['--cobre-sobre-oscuro', '#D9A273', 'Acentos en oscuro', '7,4:1'],
  ['--arena', '#F6EAD3', 'Bandas alternas (aux.)', '9,8:1 texto'],
  ['--oliva', '#55603A', 'Checks “incluido” (aux.)', '6,2:1'],
  ['--whatsapp', '#1F7A45', 'Botón WhatsApp', '5,3:1 blanco'],
];
---

<Base titulo="Sistema de diseño · GranadinIA" descripcion="Muestra interna" indexable={false}>
  <Cabecera prefijo="/" />
  <main id="contenido" class="contenedor muestra" tabindex="-1">
    <p class="antetitulo">Sistema de diseño</p>
    <h1>Granadin<span class="ia">IA</span>: tokens y componentes</h1>
    <p class="entradilla">Paleta medida sobre el logo, Nunito autoalojada y componentes con foco visible.</p>

    <h2>Paleta</h2>
    <ul class="paleta">
      {
        colores.map(([n, h, uso, c]) => (
          <li>
            <span class="muestra-color" style={`background:${h}`} />
            <strong>{n}</strong>
            <code>{h}</code>
            <span>{uso}</span>
            <span class="contraste">{c}</span>
          </li>
        ))
      }
    </ul>

    <h2>Tipografía · Nunito</h2>
    <p style="font-size:var(--h1);font-weight:800;line-height:1.1;margin:0">H1 · Que ningún cliente se te escape</p>
    <p style="font-size:var(--h2);font-weight:800;line-height:1.15;margin:0">H2 · ¿Te suena?</p>
    <p style="font-size:var(--h3);font-weight:800;margin:0 0 1rem">H3 · Ficha de Google optimizada</p>
    <p>Texto base de 18 a 20 px, interlineado 1,6 y líneas de unos 65 caracteres. Pierdes llamadas mientras trabajas, contestas WhatsApps por la noche y tienes pocas reseñas aunque trabajas bien.</p>
    <p>Un <a href="#">enlace de ejemplo</a> y un dato que falta: <span class="pendiente">[PENDIENTE: NIF]</span></p>

    <h2>Botones</h2>
    <div class="fila">
      <a class="boton boton--whatsapp boton--grande" href="#"><Icono nombre="whatsapp" />Escríbeme por WhatsApp</a>
      <a class="boton boton--grande" href="#"><Icono nombre="telefono" />Llamar</a>
      <a class="boton boton--secundario boton--grande" href="#">Ver cómo funciona <Icono nombre="flecha" /></a>
      <button class="boton" type="button">Botón normal</button>
    </div>

    <h2>Tarjetas</h2>
    <div class="tarjetas">
      <article class="tarjeta tarjeta--interactiva">
        <h3>Ficha de Google</h3>
        <p>Que te encuentren cuando buscan “electricista en Maracena”.</p>
      </article>
      <article class="tarjeta tarjeta--arco">
        <h3>Tarjeta en arco</h3>
        <p>Para destacar la oferta o enmarcar la foto de “Sobre mí”.</p>
      </article>
      <article class="tarjeta" style="background:var(--marron-noche);color:#F6EAD3;border-color:transparent">
        <h3 style="color:#FBF1DE">Sección oscura</h3>
        <p>Acento en <span style="color:var(--cobre-sobre-oscuro);font-weight:800">cobre sobre oscuro</span>.</p>
      </article>
    </div>
  </main>
</Base>

<style>
  .muestra {
    padding-block: var(--e-7);
  }
  .muestra h2 {
    margin-top: var(--e-7);
  }
  .paleta {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: var(--e-4);
    padding: 0;
    list-style: none;
    max-width: none;
  }
  .paleta li {
    display: grid;
    gap: 2px;
    font-size: 0.95rem;
  }
  .muestra-color {
    height: 4.5rem;
    border-radius: var(--radio);
    border: 1px solid var(--borde);
    margin-bottom: var(--e-2);
  }
  .contraste {
    color: var(--texto-suave);
    font-size: 0.9rem;
  }
  .fila {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
  }
  .tarjetas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--e-5);
  }
</style>
