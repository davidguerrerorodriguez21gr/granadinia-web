  )}
  {nombre === 'escudo' && (
    <>
      <path d="M12 2.8 4.5 5.5v6c0 4.6 3.1 8.2 7.5 9.7 4.4-1.5 7.5-5.1 7.5-9.7v-6z" />
      <path d="m8.5 12 2.5 2.5 4.5-5" />
