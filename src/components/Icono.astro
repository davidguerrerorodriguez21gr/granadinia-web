---
/** Iconos SVG propios, en línea y decorativos (aria-hidden). */
interface Props {
  nombre: 'whatsapp' | 'telefono' | 'correo' | 'menu' | 'cerrar' | 'luna' | 'sol' | 'flecha' | 'instagram' | 'check';
  clase?: string;
}
const { nombre, clase } = Astro.props;
---

<svg class={clase} viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  {nombre === 'whatsapp' && (
    <>
      <path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.3z" />
      <path d="M9 8.6c.2-.5.5-.6.8-.6h.5c.2 0 .4.1.5.4l.7 1.6c.1.2 0 .5-.1.7l-.5.6c-.1.2-.1.4 0 .6.6 1.1 1.5 2 2.6 2.6.2.1.4.1.6 0l.6-.5c.2-.2.5-.2.7-.1l1.6.7c.3.1.4.3.4.5v.5c0 .3-.1.6-.6.8-.6.3-1.6.5-2.9-.1a10 10 0 0 1-4.9-4.9c-.6-1.3-.4-2.3-.1-2.9z" fill="currentColor" stroke="none" />
    </>
  )}
  {nombre === 'telefono' && <path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11 11 0 0 0 5.2 5.2l1.4-2.1 4.2 1.6V17a2.5 2.5 0 0 1-2.7 2.5A15.5 15.5 0 0 1 2.5 6.2 2.5 2.5 0 0 1 5 3.5z" />}
  {nombre === 'correo' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2.5" />
      <path d="M3.5 6.5 12 13l8.5-6.5" />
    </>
  )}
  {nombre === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {nombre === 'cerrar' && <path d="M6 6l12 12M18 6 6 18" />}
  {nombre === 'luna' && <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />}
  {nombre === 'sol' && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" />
    </>
  )}
  {nombre === 'flecha' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {nombre === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
    </>
  )}
  {nombre === 'check' && <path d="M5 12.5 10 17 19 7" />}
</svg>
