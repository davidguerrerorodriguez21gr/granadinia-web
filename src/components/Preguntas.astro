---
import { preguntas as t } from '../content/textos';
---

<section id="preguntas" class="seccion" aria-labelledby="preguntas-titulo">
  <div class="contenedor faq">
    <header class="encabezado aparece">
      <p class="antetitulo">{t.antetitulo}</p>
      <h2 id="preguntas-titulo">{t.titulo}</h2>
    </header>
    <div class="faq__lista">
      {
        t.lista.map((x, i) => (
          <details class="pregunta aparece" style={`--retraso:${i * 50}ms`}>
            <summary>
              <span>{x.p}</span>
              <span class="pregunta__signo" aria-hidden="true" />
            </summary>
            <p>{x.r}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: var(--e-5);
  }
  @media (min-width: 60rem) {
    .faq {
      grid-template-columns: 0.75fr 1.25fr;
      gap: var(--e-8);
      align-items: start;
    }
  }
  .faq__lista {
    display: grid;
    gap: var(--e-3);
  }
  .pregunta {
    border: 1px solid var(--borde);
    border-radius: var(--radio-grande);
    background: var(--superficie);
    transition: box-shadow var(--medio) ease;
  }
  .pregunta[open] {
    box-shadow: var(--sombra);
    border-color: var(--decoracion);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4);
    min-height: 3.5rem;
    padding: var(--e-4) var(--e-5);
    font-size: 1.2rem;
    font-weight: var(--peso-fuerte);
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radio-grande);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .pregunta__signo {
    position: relative;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 2px solid var(--acento);
  }
  .pregunta__signo::before,
  .pregunta__signo::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.9rem;
    height: 2px;
    background: var(--acento);
    translate: -50% -50%;
    transition: rotate var(--medio) var(--curva);
  }
  .pregunta__signo::after {
    rotate: 90deg;
  }
  [open] .pregunta__signo::after {
    rotate: 0deg;
  }
  .pregunta p {
    margin: 0;
    padding: 0 var(--e-5) var(--e-5);
  }
  :global(.anima) .pregunta[open] p {
    animation: abrir 320ms var(--curva);
  }
  @keyframes abrir {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
</style>
