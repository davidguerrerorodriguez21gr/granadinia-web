---
import Logo from './Logo.astro';
import Icono from './Icono.astro';
import { sitio, whatsappConTexto, telefonoHref, correoHref, telefonoTexto } from '../config/sitio';
import { pie as t, comunes } from '../content/textos';
const ano = new Date().getFullYear();
---

<footer class="pie tema-noche">
  <div class="contenedor pie__rejilla">
    <div class="pie__marca">
      <Logo />
      <p class="pie__lema">{sitio.LEMA_LOGO}</p>
      <p>{sitio.DESCRIPTOR}. {sitio.UBICACION}.</p>
    </div>

    <div>
      <h2 class="pie__titulo">{t.zonaTitulo}</h2>
      <p>{t.zonaTexto}</p>
      <p class="pie__pueblos">{sitio.ZONA_PRESENCIAL.join(' · ')}…</p>
    </div>

    <div>
      <h2 class="pie__titulo">{t.contactoTitulo}</h2>
      <ul class="pie__lista">
        <li>
          <a href={whatsappConTexto()} rel="noopener"><Icono nombre="whatsapp" />WhatsApp <span class="sr-only">{comunes.seAbreWhatsApp}</span></a>
        </li>
        <li>
          <a href={telefonoHref}><Icono nombre="telefono" />{telefonoTexto}</a>
        </li>
        <li>
          <a href={correoHref()}><Icono nombre="correo" />{sitio.CORREO_CONTACTO}</a>
        </li>
        <li>
          <a href={sitio.INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
            <Icono nombre="instagram" />{t.instagram} <span class="sr-only">{t.nuevaPestana}</span>
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="pie__titulo">{t.legalTitulo}</h2>
      <ul class="pie__lista">
        {t.legal.map((l) => <li><a href={l.href}>{l.texto}</a></li>)}
      </ul>
      <button class="interruptor" type="button" role="switch" aria-checked="false" data-movimiento-boton hidden>
        <span class="interruptor__pista" aria-hidden="true"><span class="interruptor__bola"></span></span>
        {comunes.reducirAnimaciones}
        <span class="interruptor__nota" data-movimiento-nota hidden>(activado en tu dispositivo)</span>
      </button>
    </div>
  </div>
  <div class="contenedor pie__base">
    <p>© {ano} {sitio.NOMBRE_MARCA} · {sitio.RESPONSABLE}</p>
  </div>
</footer>

<style>
  .pie {
    padding-block: var(--e-8) var(--e-5);
    font-size: var(--texto-pequeno);
    background: #1f120b;
    --fondo: #1f120b;
  }
  .pie__rejilla {
    display: grid;
    gap: var(--e-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .pie__marca p {
    margin-top: var(--e-4);
    color: var(--texto-suave);
  }
  .pie__marca .pie__lema {
    margin-top: var(--e-2);
    font-size: 0.8rem;
    font-weight: var(--peso-fuerte);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .pie__titulo {
    margin-bottom: var(--e-3);
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--acento);
  }
  .pie__pueblos {
    color: var(--texto-suave);
    font-size: 0.95rem;
  }
  .pie__lista {
    display: grid;
    gap: var(--e-1);
    margin: 0 0 var(--e-4);
    padding: 0;
    list-style: none;
  }
  .pie__lista a {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    min-height: 44px;
    color: var(--texto);
    overflow-wrap: anywhere;
  }
  .pie__lista :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--acento);
    flex: none;
  }
  .pie__base {
    margin-top: var(--e-7);
    padding-top: var(--e-4);
    border-top: 1px solid var(--borde);
    color: var(--texto-suave);
  }
  .pie__base p {
    margin: 0;
  }

  .interruptor {
    display: inline-flex;
    align-items: center;
    gap: var(--e-3);
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--texto);
    font: inherit;
    font-weight: var(--peso-medio);
    cursor: pointer;
    border-radius: 8px;
  }
  .interruptor:disabled {
    cursor: default;
  }
  .interruptor__nota {
    color: var(--texto-suave);
    font-weight: var(--peso-normal);
  }
  .interruptor[hidden] {
    display: none;
  }
  .interruptor__pista {
    position: relative;
    width: 3rem;
    height: 1.7rem;
    border-radius: 999px;
    border: 2px solid var(--borde-control);
    background: transparent;
    transition: background-color var(--rapido) ease;
  }
  .interruptor__bola {
    position: absolute;
    top: 50%;
    left: 0.2rem;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: var(--texto);
    translate: 0 -50%;
    transition: left var(--medio) var(--curva);
  }
  [aria-checked='true'] .interruptor__pista {
    background: var(--acento);
    border-color: var(--acento);
  }
  [aria-checked='true'] .interruptor__bola {
    left: calc(100% - 1.3rem);
    background: #1f120b;
  }
</style>

<script>
  const boton = document.querySelector<HTMLButtonElement>('[data-movimiento-boton]');
  const raiz = document.documentElement;
  const sistema = matchMedia('(prefers-reduced-motion: reduce)');

  const nota = document.querySelector<HTMLElement>('[data-movimiento-nota]');
  const pintar = () => {
    const reducido = raiz.dataset.movimiento === 'reducido' || sistema.matches;
    boton?.setAttribute('aria-checked', String(reducido));
    // Si el sistema ya pide menos movimiento, manda el sistema
    if (boton) boton.disabled = sistema.matches;
    if (nota) nota.hidden = !sistema.matches;
    raiz.classList.toggle('anima', !reducido);
  };

  if (boton) {
    boton.hidden = false;
    boton.addEventListener('click', () => {
      const activar = boton.getAttribute('aria-checked') !== 'true';
      if (activar) raiz.dataset.movimiento = 'reducido';
      else delete raiz.dataset.movimiento;
      try {
        // Preferencia técnica pedida por el usuario (ver /cookies)
        if (activar) localStorage.setItem('granadinia-movimiento', 'reducido');
        else localStorage.removeItem('granadinia-movimiento');
      } catch {}
      pintar();
    });
  }
  sistema.addEventListener('change', pintar);
  pintar();
</script>
