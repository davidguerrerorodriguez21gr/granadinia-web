---
import { sobreMi as t } from '../content/textos';
import { Image } from 'astro:assets';
// Foto con el fondo quitado (scripts/quitar-fondo.mjs). Para cambiarla, sustituye src/assets/david.png
import foto from '../assets/david.png';
---

<section id="sobre-mi" class="seccion seccion--alterna" aria-labelledby="sobre-mi-titulo">
  <div class="contenedor sobre">
    <figure class="marco aparece">
      <svg class="marco__arco" viewBox="0 0 300 380" aria-hidden="true" focusable="false">
        <path d="M14 372V150a136 136 0 0 1 272 0v222" pathLength="1"></path>
      </svg>
      <div class="marco__foto">
        <Image
          src={foto}
          alt={t.fotoAlt}
          widths={[340, 680]}
          sizes="(min-width: 56rem) 22rem, 80vw"
          format="webp"
          quality={80}
          loading="lazy"
        />
      </div>
    </figure>

    <div class="sobre__texto">
      <p class="antetitulo aparece">{t.antetitulo}</p>
      <h2 id="sobre-mi-titulo" class="aparece">{t.titulo}</h2>
      {t.parrafos.map((p, i) => <p class:list={['aparece', { entradilla: i === 0 }]}>{p}</p>)}
    </div>
  </div>
</section>

<style>
  .sobre {
    display: grid;
    gap: var(--e-7);
    align-items: center;
  }
  @media (min-width: 56rem) {
    .sobre {
      grid-template-columns: minmax(16rem, 0.8fr) 1.2fr;
    }
  }
  .marco {
    position: relative;
    width: min(100%, 22rem);
    margin: 0 auto;
    aspect-ratio: 300 / 380;
  }
  .marco__foto {
    position: absolute;
    inset: 22px;
    border-radius: 999px 999px var(--radio) var(--radio);
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 35%, rgb(253 245 229 / 0.9), transparent 60%),
      linear-gradient(180deg, #e9c9a3, #b88255);
    box-shadow: var(--sombra);
  }
  .marco__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }
  .marco__hueco {
    margin: 0;
    padding: var(--e-4);
    text-align: center;
  }
  .marco__arco {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--decoracion);
    stroke-width: 3;
    overflow: visible;
  }
  @supports (animation-timeline: view()) {
    :global(.anima) .marco__arco path {
      stroke-dasharray: 1;
      animation: trazar-arco linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 45%;
    }
  }
  @keyframes trazar-arco {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
