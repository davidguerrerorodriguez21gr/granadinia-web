---
import { sobreMi as t } from '../content/textos';
// Cuando tengas la foto: guárdala en src/assets/david.jpg y cambia FOTO a true.
// import { Image } from 'astro:assets';
// import foto from '../assets/david.jpg';
const FOTO = false;
---

<section id="sobre-mi" class="seccion seccion--alterna" aria-labelledby="sobre-mi-titulo">
  <div class="contenedor sobre">
    <figure class="marco aparece">
      <svg class="marco__arco" viewBox="0 0 300 380" aria-hidden="true" focusable="false">
        <path d="M14 372V150a136 136 0 0 1 272 0v222" pathLength="1"></path>
      </svg>
      <div class="marco__foto">
        {
          FOTO ? null /* <Image src={foto} alt={t.fotoAlt} widths={[320, 640]} sizes="(min-width: 60rem) 24rem, 80vw" /> */ : (
            <p class="marco__hueco">
              <span class="pendiente">{t.fotoPendiente}</span>
            </p>
          )
        }
      </div>
    </figure>

    <div class="sobre__texto">
      <p class="antetitulo aparece">{t.antetitulo}</p>
      <h2 id="sobre-mi-titulo" class="aparece">{t.titulo}</h2>
      {t.parrafos.map((p, i) => <p class:list={['aparece', { entradilla: i === 0 }]}>{p}</p>)}
    </div>
  </div>
</section>

<style>
  .sobre {
    display: grid;
    gap: var(--e-7);
    align-items: center;
  }
  @media (min-width: 56rem) {
    .sobre {
      grid-template-columns: minmax(16rem, 0.8fr) 1.2fr;
    }
  }
  .marco {
    position: relative;
    width: min(100%, 22rem);
    margin: 0 auto;
    aspect-ratio: 300 / 380;
  }
  .marco__foto {
    position: absolute;
    inset: 22px;
    border-radius: 999px 999px var(--radio) var(--radio);
    overflow: hidden;
    background:
      repeating-linear-gradient(45deg, transparent 0 14px, rgb(184 130 85 / 0.12) 14px 15px),
      var(--superficie);
    display: grid;
    place-items: center;
    box-shadow: var(--sombra);
  }
  .marco__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .marco__hueco {
    margin: 0;
    padding: var(--e-4);
    text-align: center;
  }
  .marco__arco {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--decoracion);
    stroke-width: 3;
    overflow: visible;
  }
  @supports (animation-timeline: view()) {
    :global(.anima) .marco__arco path {
      stroke-dasharray: 1;
      animation: trazar-arco linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 45%;
    }
  }
  @keyframes trazar-arco {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
